{
  "name": "binge_verse_new",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "wait-on tcp:4000 && vite dev",
    "dev:server": "tsx watch server/server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "node dist-server/server/server.js",
    "typecheck": "tsc --noEmit",
    "generate:api": "tsx scripts/generate-api-types.ts",
    "check:api": "tsx scripts/generate-api-types.ts --check",
    "test": "tsx scripts/test.ts",
    "test:integration": "npm run build && tsx scripts/test-integration.ts",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:build": "vite build && tsc -p tsconfig.server.json --sourceMap --inlineSources",
    "test:server:coverage": "npm run test:build && c8 node --import tsx scripts/test-integration.ts",
    "test:e2e:coverage": "tsc -p tsconfig.server.json --sourceMap --inlineSources && c8 --clean=false playwright test",
    "test:coverage:check": "c8 check-coverage --lines=90 --statements=90 --functions=85 --branches=70",
    "test:all": "npm run check:api && npm run lint && npm run typecheck && npm run test:server:coverage && npm run test:components:coverage && npm run test:e2e:coverage && npm run test:coverage:check",
    "demo:preview": "npm run build && tsx scripts/preview-demo.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:migrate:ratings": "tsx scripts/migrate-rating-indexes.ts",
    "user:role": "tsx scripts/set-user-role.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
