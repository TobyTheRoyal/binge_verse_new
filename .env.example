# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
# Demo accounts are enabled by default locally, explicitly opt in for production.
DEMO_ENABLED=true
DEMO_TTL_SECONDS=86400
DEMO_RATE_LIMIT=5
DEMO_DAILY_LIMIT=200
REGISTRATION_ENABLED=true
SERVE_WEB=false
RUN_MIGRATIONS=false
HOST=127.0.0.1
PORT=4000
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=binge_verse
TMDB_API_KEY=
TMDB_LANGUAGE=de-DE
OMDB_API_KEY=
# Required in production: shared rate limits across all application instances.
REDIS_URL=
# Only configure the exact proxy addresses used by your hosting provider.
TRUST_PROXY=
SESSION_TTL_SECONDS=604800
API_RATE_LIMIT=300
API_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT=15
RATE_LIMIT_WINDOW_MS=900000
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_CONCURRENCY=8
UPSTREAM_QUEUE_LIMIT=100
METADATA_CACHE_MAX=2000
METADATA_CACHE_MAX_BYTES=33554432
METADATA_CACHE_TTL_MS=300000
GRAPHQL_MAX_TOKENS=10000
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_ALIASES=15
GRAPHQL_MAX_COST=15000
GRAPHQL_MAX_ROOT_FIELDS=10
GRAPHQL_MAX_ARRAY_ITEMS=200
GRAPHQL_MAX_QUERY_LENGTH=32768
DATABASE_MAX_TIME_MS=5000
DATABASE_POOL_SIZE=20
